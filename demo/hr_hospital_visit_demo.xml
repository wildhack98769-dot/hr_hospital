<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="visit_1" model="hr.hospital.visit">
            <field name="patient_id" ref="patient_1"/>
            <field name="doctor_id" ref="doctor_house"/>
            <field name="planned_date" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">planned</field>
        </record>

        <record id="visit_2" model="hr.hospital.visit">
            <field name="patient_id" ref="patient_2"/>
            <field name="doctor_id" ref="doctor_cuddy"/>
            <field name="planned_date" eval="(datetime.now() - relativedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">done</field>
            <field name="summary">Seasonal allergy</field>
        </record>

        <record id="visit_5" model="hr.hospital.visit">
            <field name="patient_id" ref="patient_1"/>
            <field name="doctor_id" ref="doctor_house"/>
            <field name="planned_date" eval="(datetime.now() - relativedelta(days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">cancelled</field>
        </record>
    </data>
</odoo>